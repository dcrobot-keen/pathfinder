# scan-engine (FastAPI) 로컬 설정 -- scripts/dev-scan-engine.mjs 가 읽는다. 복사해서 .env 로.
# 앱(vps-system/ios-capture)이 내보낸 다중 스캔 그룹 폴더: <group>/<scan_*>/{scan.usdz, textured.glb, floorplan.*}, group_alignment.json
STUDIO_GROUPS_DIR=../../vps-system/data
# 정합 저장 시 합성 <group>.slicemap.json / .floor.png 를 복사할 곳 (시뮬레이터 월드 폴더)
STUDIO_PUBLISH_DIR=../deploy/worlds
# 슬라이스 높이 (m)
STUDIO_SLICE_Z=0.18
SCAN_ENGINE_PORT=8000
