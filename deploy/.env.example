# docker compose -f deploy/docker-compose.yml 가 읽는 기본값. 복사해서 deploy/.env 로 (gitignored).
# 형제 저장소 위치: 그 아래에 robot-os-chromium/ 와 simulator/ 체크아웃이 있어야 한다 (기본 = 워크스페이스 루트/ros-chromium)
ROS_CHROMIUM_DIR=../../ros-chromium
# 시뮬레이터 월드: 정합 워크스페이스가 publish 한 슬라이스맵 (simulator/worlds/ 기준 경로) 또는 worlds/*.world.json
SIM_WORLD=worlds/project_20260905.slicemap.json
# 한 월드의 로봇들: "id@x,y,theta;id2@auto". 로봇 i 는 8765+10i / 8766+10i 포트
SIM_ROBOTS=tb3-sim-01@auto;tb3-sim-02@9.28,9.47,0
